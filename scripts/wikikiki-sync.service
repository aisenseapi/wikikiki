[Unit]
Description=Wikikiki workspace sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wikikiki-sync
Group=wikikiki-sync
EnvironmentFile=/etc/wikikiki/sync.env
Environment=WIKIKIKI_STATE_DIR=/var/lib/wikikiki-sync
StateDirectory=wikikiki-sync
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/lib/wikikiki/wikikiki-sync.py
# Stop on conflicts. The operator reconciles the page before restarting.
Restart=no
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wikikiki-sync

[Install]
WantedBy=multi-user.target
